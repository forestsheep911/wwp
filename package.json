{
  "name": "wwpdw",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @wwpdw/web",
    "dev:api": "npm run dev --workspace @wwpdw/api",
    "dev:worker": "npm run dev --workspace @wwpdw/worker",
    "home:build": "npm run build --workspace @wwpdw/web",
    "home:test": "node --test --import tsx apps/api/src/static-web.test.ts apps/api/src/playback-admission.test.ts",
    "home:sync-index": "node --import tsx tools/sync-home-search-index.mjs",
    "home:start": "node --import tsx tools/start-home-site.mjs",
    "home:serve": "npm run home:build && npm run home:start",
    "sync:meta": "npm --workspace @wwpdw/api run sync:meta --",
    "sync:family-age-index": "npm --workspace @wwpdw/api run sync:family-age-index --",
    "sync:title-index": "npm --workspace @wwpdw/api run sync:title-index --",
    "sync:genre-index": "npm --workspace @wwpdw/api run sync:genre-index --",
    "sync:catalog": "npm run sync:catalog --workspace @wwpdw/api",
    "sync:tspdt": "npm run sync:tspdt --workspace @wwpdw/api",
    "notion:metadata": "npm --workspace @wwpdw/api run notion:metadata --",
    "notion:workflow-handoff": "node tools/notion-workflow-handoff.mjs",
    "notion:audit": "npm --workspace @wwpdw/api run notion:audit --",
    "notion:omdb": "npm --workspace @wwpdw/api run notion:omdb --",
    "notion:imdb-rating": "node tools/notion-imdb-rating-enrichment.mjs",
    "notion:critic-ratings": "node tools/notion-critic-rating-enrichment.mjs",
    "notion:family-age": "npm --workspace @wwpdw/api run notion:family-age --",
    "notion:title-cleanup": "npm --workspace @wwpdw/api run notion:title-cleanup --",
    "notion:genre-cleanup": "npm --workspace @wwpdw/api run notion:genre-cleanup --",
    "notion:release-date-cleanup": "tsx apps/api/src/notion-release-date-cleanup.ts",
    "notion:asset-audit": "node tools/notion-media-assets-audit.mjs",
    "notion:asset-batch": "node tools/notion-media-assets-generate-batch.mjs",
    "notion:asset-filter": "node tools/notion-media-assets-filter-batch.mjs",
    "notion:asset-leftovers": "node tools/notion-media-assets-leftovers-report.mjs",
    "notion:asset-stats": "node tools/notion-media-assets-stats.mjs",
    "notion:asset-write": "node tools/notion-media-assets-write.mjs",
    "notion:manual-upload-organizer": "node tools/notion-manual-upload-organizer.mjs",
    "notion:title-prefix-cleanup": "node tools/notion-title-prefix-cleanup.mjs",
    "notion:series-audit": "node tools/notion-series-structure-audit.mjs",
    "notion:series-asset-write": "node tools/notion-media-assets-write-series.mjs",
    "film:queue-watch": "node .codex/plugins/wwp-film-workflow/scripts/watch-input-directory.mjs",
    "film:ledger": "node tools/film-ledger.mjs",
    "film:ledger:test": "node --test tools/lib/film-ledger-*.test.mjs tools/film-ledger.test.mjs",
    "backfill:tspdt-imdb": "npm run backfill:tspdt-imdb --workspace @wwpdw/api",
    "build": "npm run build --workspace @wwpdw/web && npm run build --workspace @wwpdw/api && npm run build --workspace @wwpdw/worker",
    "typecheck": "npm run typecheck --workspace @wwpdw/web && npm run typecheck --workspace @wwpdw/api && npm run typecheck --workspace @wwpdw/worker"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.6",
    "node-fetch": "^3.3.2"
  }
}

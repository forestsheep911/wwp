{
  "name": "wwpdw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @wwpdw/web",
    "dev:api": "npm run dev --workspace @wwpdw/api",
    "dev:worker": "npm run dev --workspace @wwpdw/worker",
    "sync:catalog": "npm run sync:catalog --workspace @wwpdw/api",
    "sync:tspdt": "npm run sync:tspdt --workspace @wwpdw/api",
    "notion:metadata": "npm --workspace @wwpdw/api run notion:metadata --",
    "notion:audit": "npm --workspace @wwpdw/api run notion:audit --",
    "notion:omdb": "npm --workspace @wwpdw/api run notion:omdb --",
    "notion:asset-audit": "node tools/notion-media-assets-audit.mjs",
    "notion:asset-batch": "node tools/notion-media-assets-generate-batch.mjs",
    "notion:asset-write": "node tools/notion-media-assets-write.mjs",
    "backfill:tspdt-imdb": "npm run backfill:tspdt-imdb --workspace @wwpdw/api",
    "build": "npm run build --workspace @wwpdw/web && npm run build --workspace @wwpdw/api && npm run build --workspace @wwpdw/worker",
    "typecheck": "npm run typecheck --workspace @wwpdw/web && npm run typecheck --workspace @wwpdw/api && npm run typecheck --workspace @wwpdw/worker"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.6",
    "node-fetch": "^3.3.2"
  }
}

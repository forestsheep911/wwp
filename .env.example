API_PORT=8787
WWPDW_LOCAL_DATA_DIR=.local-data
VITE_ACCESS_CODE=family
VITE_API_BASE_URL=

# Notion integration token. Use a read-only integration and never grant write capabilities.
NOTION_READ_ONLY_TOKEN=

# local (default) or azure
CACHE_BACKEND=local

# Azure backend defaults match infra/provision.ps1
AZURE_STORAGE_ACCOUNT_NAME=stwwcachee9219db7
AZURE_STORAGE_BLOB_CONTAINER=cached-videos
AZURE_STORAGE_QUEUE_NAME=cache-jobs
AZURE_STORAGE_ASSET_TABLE=cacheindex
AZURE_STORAGE_JOB_TABLE=cachejobs
AZURE_STORAGE_PLAYBACK_SAS_MINUTES=60

# Optional for local Azure testing. In Container Apps, prefer managed identity.
# AZURE_STORAGE_CONNECTION_STRING=

# Azure control plane trigger for starting the cache worker Container Apps Job.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-ww-player-cache-dev
AZURE_CONTAINER_APP_JOB_NAME=job-ww-cache-worker
AZURE_CONTAINER_APP_JOB_API_VERSION=2024-03-01

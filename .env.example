API_PORT=8787
WWPDW_LOCAL_DATA_DIR=.local-data
VITE_API_BASE_URL=

# Server-side private access key. The frontend stores user input and the API checks this value.
WWPDW_ACCESS_KEY=
# Optional separate administrator key. If unset, WWPDW_ACCESS_KEY acts as the administrator key.
WWPDW_ADMIN_KEY=

# Notion integration token. Use a read-only integration and never grant write capabilities.
NOTION_READ_ONLY_TOKEN=

# auto uses Notion when NOTION_READ_ONLY_TOKEN exists; mock forces the demo catalog.
WWPDW_SEARCH_SOURCE=auto

# Preferred Notion scope: a root page with one direct child database.
# PAGE_ID is also accepted locally for compatibility with the existing skill env.
NOTION_LIBRARY_ROOT_PAGE_ID=
# Optional explicit overrides if the root page ever contains more than one database.
NOTION_LIBRARY_DATABASE_ID=
NOTION_LIBRARY_DATA_SOURCE_ID=
NOTION_SEARCH_PAGE_SIZE=8
NOTION_PARSE_MAX_PAGES=6
NOTION_PARSE_BLOCK_DEPTH=2
NOTION_PARSE_BLOCK_LIMIT=120
NOTION_TITLE_SCAN_LIMIT=120
NOTION_TITLE_MATCH_LIMIT=6
NOTION_LIBRARY_QUERY_LIMIT=300
NOTION_VARIANT_LIMIT=8

# local (default) or azure
CACHE_BACKEND=local
CACHE_ASSET_TTL_DAYS=30
# Member Cinema Pass defaults. New cache jobs cost MEMBER_CACHE_CREDIT_COST 🍀.
# Cache hits and already-running cache jobs do not spend credits.
MEMBER_DEFAULT_CREDITS=20
MEMBER_CACHE_CREDIT_COST=1
# Optional MP4 faststart probe size in bytes. Defaults to 4 MiB and is capped at 16 MiB.
CACHE_MP4_PROBE_BYTES=4194304

# Azure backend defaults match infra/provision.ps1
AZURE_STORAGE_ACCOUNT_NAME=stwwcachee9219db7
AZURE_STORAGE_BLOB_CONTAINER=cached-videos
AZURE_STORAGE_QUEUE_NAME=cache-jobs
AZURE_STORAGE_ASSET_TABLE=cacheindex
AZURE_STORAGE_JOB_TABLE=cachejobs
AZURE_STORAGE_MEMBER_TABLE=membercodes
AZURE_STORAGE_PLAYBACK_SAS_MINUTES=60

# Optional for local Azure testing. In Container Apps, prefer managed identity.
# AZURE_STORAGE_CONNECTION_STRING=

# Azure control plane trigger for starting the cache worker Container Apps Job.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-ww-player-cache-dev
AZURE_CONTAINER_APP_JOB_NAME=job-ww-cache-worker
AZURE_CONTAINER_APP_JOB_API_VERSION=2024-03-01

API_PORT=8787
WWPDW_LOCAL_DATA_DIR=.local-data
VITE_API_BASE_URL=

# Home-site single-origin process. The NAS may proxy public HTTPS 38443 to this
# unusual local TCP port. Keep the public origin's explicit port.
WWPDW_HOME_PORT=43187
WWPDW_HOME_PUBLIC_ORIGIN=
WWPDW_HOME_DATA_DIR=.local-data/home-site
WWPDW_HOME_CACHE_BACKEND=filesystem
WWPDW_MEDIA_ROOT=F:\wwp_storage
WWPDW_MEDIA_MAX_BYTES=1099511627776
WWPDW_MEDIA_MIN_FREE_BYTES=107374182400
WWPDW_MAX_PLAYBACK_STREAMS=8
WORKER_MAX_CONCURRENT=2
WWPDW_PLAYBACK_GRANT_MINUTES=360
WWPDW_WEB_DIST_DIR=apps/web/dist

# Home hybrid backends: accounts use Azure while browser sessions stay local.
# Movie metadata, posters, TSPDT browse data, media, and cache-job state stay local.
WWPDW_AUTH_BACKEND=azure
WWPDW_SESSION_BACKEND=local
SEARCH_INDEX_BACKEND=local
TSPDT_BROWSE_BACKEND=local
SEARCH_INDEX_WRITE_THROUGH=false
WWPDW_HOME_NOTION_SYNC_ENABLED=true
WWPDW_HOME_NOTION_SYNC_INTERVAL_MINUTES=30
WWPDW_HOME_NOTION_FULL_SYNC_MIN_ENTRIES=500
SEARCH_INDEX_SYNC_CONCURRENCY=2
SEARCH_INDEX_SYNC_LOCAL_PUBLISH_BATCH_SIZE=50

# Static Web Apps Function cache for the first home browse request.
WWPDW_ORIGIN_API_BASE_URL=
WWPDW_HOME_CACHE_STORAGE_CONNECTION_STRING=
WWPDW_HOME_CACHE_CONTAINER=web-cache
WWPDW_HOME_BROWSE_FRESH_SECONDS=600
WWPDW_HOME_BROWSE_STALE_SECONDS=604800
WWPDW_HOME_BROWSE_ORIGIN_TIMEOUT_MS=25000
WWPDW_HOME_BROWSE_STALE_REFRESH_TIMEOUT_MS=1800

# Public Notion library homepage, useful for human reference and local tools.
PUBLIC_URL=

# Static administrator key for the Admin tab.
WWPDW_ADMIN_KEY=
# Comma-separated browser origins permitted to send authenticated cookie requests.
WWPDW_ALLOWED_WEB_ORIGINS=http://127.0.0.1:5173
WWPDW_SESSION_IDLE_SECONDS=2592000
WWPDW_SESSION_ABSOLUTE_SECONDS=7776000
WWPDW_SESSION_RENEWAL_SECONDS=86400

# Notion integration token. Use a read-only integration and never grant write capabilities.
NOTION_READ_ONLY_TOKEN=

# auto uses Notion when NOTION_READ_ONLY_TOKEN exists; mock forces the demo catalog.
WWPDW_SEARCH_SOURCE=auto

# Preferred Notion scope: a root page containing the main library database and
# the Media Assets database.
NOTION_LIBRARY_ROOT_PAGE_ID=
NOTION_PUBLIC_SITE_URL=https://wwpdw.notion.site
# Explicit main library database/data-source IDs. Keep these set once known so
# tools do not need to enumerate the root page.
NOTION_LIBRARY_DATABASE_ID=
NOTION_LIBRARY_DATA_SOURCE_ID=
# Explicit Media Assets database/data-source IDs. One asset row represents one
# playable video, episode video, source archive, original-disc package, subtitle
# package, or extra.
NOTION_MEDIA_ASSETS_DATABASE_ID=
NOTION_MEDIA_ASSETS_DATA_SOURCE_ID=
NOTION_SEARCH_PAGE_SIZE=8
NOTION_PARSE_MAX_PAGES=6
NOTION_PARSE_BLOCK_DEPTH=2
NOTION_PARSE_BLOCK_LIMIT=120
NOTION_TITLE_SCAN_LIMIT=120
NOTION_TITLE_MATCH_LIMIT=6
NOTION_LIBRARY_QUERY_LIMIT=300
NOTION_VARIANT_LIMIT=8
NOTION_REQUEST_TIMEOUT_MS=30000
# Optional direct DNS override when api.notion.com is unstable from the host.
NOTION_API_RESOLVE_IP=
NOTION_SCAN_PAGE_PARSE_TIMEOUT_MS=60000
NOTION_SCAN_PAGE_PARSE_RETRIES=3
NOTION_SCAN_PAGE_PARSE_RETRY_DELAY_MS=60000

# Local maintenance tools only. These are not required by the deployed API.
# Prefer NOTION_WRITE_TOKEN for scripts that modify Notion. NOTION_TOKEN is kept
# as a legacy local alias.
NOTION_WRITE_TOKEN=
NOTION_TOKEN=
OMDB_API_KEY=

# Persistent movie metadata index. Search reads this first, then falls back to Notion on miss.
SEARCH_RESULT_CACHE_TTL_SECONDS=600
SEARCH_RESULT_CACHE_LIMIT=100
SEARCH_INDEX_ENABLED=true
SEARCH_INDEX_WRITE_THROUGH=true
SEARCH_INDEX_REFRESH_ON_CACHE=true
SEARCH_INDEX_REFRESH_MEDIA_ASSETS_ON_HIT=true
SEARCH_INDEX_RESULT_LIMIT=8
SEARCH_INDEX_SYNC_LIMIT=0
SEARCH_INDEX_SYNC_DELAY_MS=1500
SEARCH_INDEX_SYNC_PAGE_SIZE=25
SEARCH_INDEX_SYNC_PROGRESS_EVERY=10
SEARCH_INDEX_INCREMENTAL_OVERLAP_MINUTES=10
SEARCH_INDEX_INCREMENTAL_BOOTSTRAP_LIMIT=200
SEARCH_INDEX_FULL_DELETE_MISSING=true
POSTER_CACHE_ENABLED=true
POSTER_CACHE_MAX_BYTES=8388608
POSTER_CACHE_MAX_PER_MOVIE=0

# local (default) or azure
CACHE_BACKEND=local
CACHE_ASSET_IDLE_TTL_DAYS=7
# Optional worker AI fallback. When configured, the worker asks the model to
# extract a direct playable media URL after rule-based resolution says a source
# needs browser inspection.
WWPDW_AI_RESOLVER_ENABLED=auto
# Presets: compass=balanced A, spark=fast A, summit=smart A,
# harbor=balanced B, glint=fast B. Aliases: balanced, fast, smart,
# balanced-b, fast-b.
WWPDW_AI_RESOLVER_MODEL_PRESET=compass
# Direct model override. Leave empty to use the selected preset.
WWPDW_AI_RESOLVER_MODEL=
WWPDW_AI_RESOLVER_API_KIND=
WWPDW_AI_RESOLVER_TIMEOUT_MS=25000
WWPDW_AI_RESOLVER_FETCH_TIMEOUT_MS=10000
WWPDW_AI_RESOLVER_FETCH_MAX_BYTES=120000
WWPDW_AI_RESOLVER_API_URL=
WWPDW_AI_RESOLVER_AUTH_HEADER=authorization
WWPDW_AI_SUMMARY_MODEL_PRESET=spark
WWPDW_AI_SUMMARY_MODEL=
WWPDW_AI_SUMMARY_TIMEOUT_MS=45000
WWPDW_AI_SUMMARY_API_URL=
WWPDW_AI_SUMMARY_BASE_URL=
WWPDW_AI_SUMMARY_AUTH_HEADER=authorization
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
BAILIAN_API_KEY=
BAILIAN_MODEL=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Member pass defaults. New cache jobs cost MEMBER_CACHE_CREDIT_COST 🍀.
# Cache hits and already-running cache jobs do not spend credits.
# Cloud defaults to enabled. The home launcher forces billing off.
WWPDW_CREDIT_BILLING_ENABLED=true
MEMBER_DEFAULT_CREDITS=200
MEMBER_CACHE_CREDIT_COST=10
MEMBER_PLAYBACK_CREDIT_BYTES=100000000
# Optional MP4 faststart probe size in bytes. Defaults to 4 MiB and is capped at 16 MiB.
CACHE_MP4_PROBE_BYTES=4194304

# Azure backend defaults match infra/provision.ps1
AZURE_STORAGE_ACCOUNT_NAME=stwwcachee9219db7
AZURE_STORAGE_BLOB_CONTAINER=cached-videos
AZURE_STORAGE_QUEUE_NAME=cache-jobs
AZURE_STORAGE_ASSET_TABLE=cacheindex
AZURE_STORAGE_JOB_TABLE=cachejobs
AZURE_STORAGE_OSS_PREPARATION_TABLE=osspreparejobs
AZURE_STORAGE_MEMBER_TABLE=membercodes
AZURE_STORAGE_SEARCH_INDEX_TABLE=movieindex
AZURE_STORAGE_PLAYBACK_SAS_MINUTES=720
AZURE_STORAGE_POSTER_SAS_MINUTES=1440

# Optional for local Azure testing. In Container Apps, prefer managed identity.
# AZURE_STORAGE_CONNECTION_STRING=

# Alibaba Cloud domestic-playback POC. Put real credentials only in the ignored
# local .env file. The initial broad RAM account should be replaced with a
# least-privilege RAM identity after the POC.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# Optional. Leave empty for a long-lived RAM user AccessKey; fill only when
# temporary STS credentials are used.
ALIBABA_CLOUD_SECURITY_TOKEN=

# Existing OSS bucket details. Example SDK region: oss-cn-shanghai.
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
# SDK endpoint, for example: https://oss-cn-shanghai.aliyuncs.com
ALIYUN_OSS_ENDPOINT=
# Optional same-region FC endpoint, for example:
# https://oss-cn-shanghai-internal.aliyuncs.com
ALIYUN_OSS_INTERNAL_ENDPOINT=
# Browser-facing base URL for the old bucket, for example:
# https://<bucket>.oss-cn-shanghai.aliyuncs.com
ALIYUN_OSS_PLAYBACK_BASE_URL=
ALIYUN_OSS_OBJECT_PREFIX=wwpdw/prepared
ALIYUN_OSS_SIGNED_URL_MINUTES=60
ALIYUN_OSS_POC_ENABLED=false
ALIYUN_OSS_POC_OBJECT_KEY=wwpdw/poc/browser-inline-range.mp4

# Future Notion-to-OSS asynchronous preparation worker.
ALIYUN_ACCOUNT_ID=
ALIYUN_FC_REGION=cn-shanghai
ALIYUN_FC_FUNCTION_NAME=wwpdw-oss-prepare
ALIYUN_FC_PREPARE_CONCURRENCY=2

# Azure control plane trigger for starting the cache worker Container Apps Job.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-ww-player-cache-dev
AZURE_CONTAINER_APP_JOB_NAME=job-ww-cache-worker
AZURE_CONTAINER_APP_JOB_API_VERSION=2024-03-01

# AI
BAILIAN_API_KEY=

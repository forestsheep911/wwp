{
  "rules": [
    {
      "enabled": false,
      "name": "expireCachedVideos",
      "type": "Lifecycle",
      "definition": {
        "actions": {
          "baseBlob": {
            "delete": {
              "daysAfterModificationGreaterThan": 30
            }
          }
        },
        "filters": {
          "blobTypes": [
            "blockBlob"
          ],
          "prefixMatch": [
            "cached-videos/"
          ]
        }
      }
    }
  ]
}
